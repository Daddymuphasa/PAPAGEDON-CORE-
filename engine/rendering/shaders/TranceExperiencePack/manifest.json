    "accent": "#FFD38A",
    "highlight": "#F2D9FF",
    "shadow": "#030614",
    "mood": [
      "night",
      "dreamy",
      "classy",
      "rnb",
      "cocktail",
      "outdoor",
      "slow",
      "immersive"
    ]
  },
